# ==========================================
# Telegram API Credentials (from https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ==========================================
# Telegram Bot Token (from @BotFather)
# ==========================================
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ==========================================
# Telethon User Session String
# Generated by running: python generate_session.py
# (Required for headless/Render hosting so Telegram won't ask for OTP on server)
# ==========================================
SESSION_STRING=

# ==========================================
# Database Connection (MongoDB Atlas free tier)
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# ==========================================
# Monitored Telegram Channel(s)
# Can be single ID (-1001234567890), channel username (@mychannel),
# or comma-separated list (-1001234567890, -1009876543210, @alpha_channel)
# ==========================================
CHANNEL_ID=-1001234567890
CHANNEL="Alpha Radar Channel"

# ==========================================
# Bot Administrators
# Telegram user IDs allowed to run admin commands (/broadcast, /block, /users, etc.)
# Comma-separated for multiple admins
# ==========================================
ADMIN_IDS=1947158378

# ==========================================
# Free Render Hosting (Self Keep-Alive)
# Render's free tier sleeps after 15 mins of inactivity.
# Set this to your Render service URL (e.g. https://your-bot.onrender.com)
# The bot will automatically ping itself every 10 minutes to stay awake 24/7!
# ==========================================
KEEP_ALIVE_URL=https://your-bot-service.onrender.com
PORT=8080
